---
import Layout from '../../layouts/Layout.astro';
import { authenticatedFetch, AuthRefreshError, backend, getSession } from '../../lib/auth';
import { resolveLocale } from '../../i18n';
import { dashboard } from '../../i18n/dashboard';
import { appPath } from '../../lib/paths';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect(appPath('auth/login'));
const locale = resolveLocale(Astro.request);
const t = dashboard[locale];
let response;
try {
  response = await authenticatedFetch(session, Astro.cookies, `${backend}/admin/users`, { headers: { 'Accept-Language': locale } });
} catch (error) {
  if (error instanceof AuthRefreshError) return Astro.redirect(appPath('auth/login'));
  throw error;
}
if (response.status === 403) Astro.response.status = 403;
const users = response.ok ? await response.json() : [];
---
<Layout title={`${t.operations} — Speech`}>
  <main class="dashboard shell">
    <nav class="dashboard-nav"><a class="wordmark" href={appPath('')}><span class="mark">S</span> speech</a><a href={appPath('dashboard')}>{t.dashboard}</a><a href={appPath('auth/logout')}>{t.logout}</a></nav>
    <p class="eyebrow">{t.operations}</p>
    <h1>{t.users}</h1>
    <table>
      <thead><tr><th>{t.identifier}</th><th>{t.plan}</th><th>{t.usage}</th></tr></thead>
      <tbody>{users.map((user) => (
        <tr><td>{user.subject_id}</td><td>{user.plan}</td><td>{user.usage.toLocaleString()} {t.words}</td></tr>
      ))}</tbody>
    </table>
  </main>
</Layout>
