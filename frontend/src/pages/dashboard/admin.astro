---
import Layout from '../../layouts/Layout.astro';
import { backend, getSession } from '../../lib/auth';

const session = getSession(Astro.cookies)!;
const response = await fetch(`${backend}/admin/users`, { headers: { Authorization: `Bearer ${session.accessToken}` } });
if (response.status === 403) Astro.response.status = 403;
const users = response.ok ? await response.json() : [];
---
<Layout title="Admin — Speech">
  <main class="dashboard shell">
    <nav class="dashboard-nav"><a class="wordmark" href="/">speech</a><a href="/dashboard">Dashboard</a><a href="/auth/logout">Log out</a></nav>
    <p class="eyebrow">Operations</p>
    <h1>Users</h1>
    <table>
      <thead><tr><th>Identifier</th><th>Plan</th><th>Usage</th></tr></thead>
      <tbody>{users.map((user) => (
        <tr><td>{user.subject_id}</td><td>{user.plan}</td><td>{user.usage.toLocaleString()} words</td></tr>
      ))}</tbody>
    </table>
  </main>
</Layout>
