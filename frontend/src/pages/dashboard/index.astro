---
import Layout from '../../layouts/Layout.astro';
import { authenticatedFetch, AuthRefreshError, backend, getSession } from '../../lib/auth';
import { resolveLocale } from '../../i18n';
import { dashboard } from '../../i18n/dashboard';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/auth/login');
const locale = resolveLocale(Astro.request);
const t = dashboard[locale];
let meResponse, usageResponse, plansResponse, historyResponse;
try {
  const headers = { 'Accept-Language': locale };
  [meResponse, usageResponse, plansResponse, historyResponse] = await Promise.all([
    authenticatedFetch(session, Astro.cookies, `${backend}/me`, { headers }), authenticatedFetch(session, Astro.cookies, `${backend}/usage`, { headers }), authenticatedFetch(session, Astro.cookies, `${backend}/plans`, { headers }), authenticatedFetch(session, Astro.cookies, `${backend}/billing/history`, { headers }),
  ]);
} catch (error) {
  if (error instanceof AuthRefreshError) return Astro.redirect('/auth/login');
  throw error;
}
const me = await meResponse.json();
const usage = await usageResponse.json();
const plans = plansResponse.ok ? await plansResponse.json() : [];
const paymentHistory = historyResponse.ok ? await historyResponse.json() : [];
const upgradePlans = plans.filter((plan) => plan.tier_id !== me.plan && plan.stripe_price_id);
const currentPlan = plans.find((plan) => plan.tier_id === me.plan);
const planName = currentPlan?.display_name ?? me.plan.replace('plan-', '');
const displayName = session.claims.preferred_username ?? me.subject_id;
const isAdmin = session.claims.plan?.includes('admin');
const hasCloudQuota = usage.limit > 0;
---
<Layout title={`${t.dashboard} — Speech`}>
  <main class="dashboard shell">
    <nav class="dashboard-nav"><a class="wordmark" href="/"><span class="mark">S</span> speech</a><span>{displayName}</span><a href="/auth/logout">{t.logout}</a></nav>
    <p class="eyebrow">{t.yourDashboard}</p>
    <h1>{planName}</h1>
    <section class="dashboard-grid">
      <article>
        <p class="eyebrow">{t.currentPeriod}</p>
        {hasCloudQuota ? (
          <>
            <strong>{usage.used.toLocaleString()} / {usage.limit.toLocaleString()}</strong>
            <p>{t.wordsUsed} · {usage.remaining.toLocaleString()} {t.remaining}</p>
          </>
        ) : (
          <>
            <strong>{t.unlimited}</strong>
            <p>{t.localNoLimit}</p>
          </>
        )}
      </article>
      <article>
        <p class="eyebrow">{t.billing}</p>
        <p>{t.currentPlan} <strong>{planName}</strong></p>
        <div class="actions">{upgradePlans.length > 0 && <form method="post" action="/dashboard/checkout"><select name="plan_id" aria-label={t.choosePlan}>{upgradePlans.map((plan) => <option value={plan.tier_id}>{plan.display_name}</option>)}</select><button class="button button-primary">{t.upgrade}</button></form>}<a class="button button-secondary" href="/dashboard/portal">{t.manageBilling}</a></div>
      </article>
    </section>
    <section>
      <p class="eyebrow">{t.paymentHistory}</p>
      {!historyResponse.ok ? <p>{t.paymentHistoryError}</p> : paymentHistory.length > 0 ? <table><thead><tr><th>{t.paymentDate}</th><th>{t.paymentAmount}</th><th>{t.paymentStatus}</th></tr></thead><tbody>{paymentHistory.map((payment) => <tr><td>{new Date(payment.created_at).toLocaleDateString(locale)}</td><td>{new Intl.NumberFormat(locale, { style: 'currency', currency: payment.currency.toUpperCase() }).format(payment.amount_paid / 100)}</td><td>{payment.status}</td></tr>)}</tbody></table> : <p>{t.noPayments}</p>}
    </section>
    {isAdmin && <a href="/dashboard/admin">{t.adminDashboard}</a>}
  </main>
</Layout>
