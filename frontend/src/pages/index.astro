---
import Layout from '../layouts/Layout.astro';
import { resolveLocale } from '../i18n';
import { landing } from '../i18n/landing';

const locale = resolveLocale(Astro.request);
const t = landing[locale];
const features = [['01', t.feature1Title, t.feature1Copy], ['02', t.feature2Title, t.feature2Copy], ['03', t.feature3Title, t.feature3Copy], ['04', t.feature4Title, t.feature4Copy], ['05', t.feature5Title, t.feature5Copy], ['06', t.feature6Title, t.feature6Copy]];

const loginUrl = '/auth/login';
---

<Layout>
  <header class="nav shell">
    <a class="wordmark" href="/" aria-label="Speech home"><span class="mark">S</span> speech</a>
    <nav aria-label={t.mainNavigation}>
      <a href="#features">{t.features}</a>
      <a href="#pricing">{t.pricing}</a>
      <a class="nav-login" href={loginUrl}>{t.login}</a>
    </nav>
  </header>

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">{t.heroEyebrow}<span class="dot">.</span></p>
        <h1>{t.heroTitleA}<br /><em>{t.heroTitleB}</em></h1>
        <p class="lede">{t.heroLead}</p>
        <div class="actions">
          <a class="button button-primary" href="#download">{t.download} <span>↗</span></a>
          <a class="text-link" href={loginUrl}>{t.signup} <span>→</span></a>
        </div>
        <p class="platforms">Windows · macOS · Linux &nbsp; / &nbsp; No account required for local dictation</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orb-glow"></div>
        <div class="orb"><div class="orb-core"></div></div>
        <div class="sound sound-one"></div><div class="sound sound-two"></div><div class="sound sound-three"></div>
        <span class="art-label label-top">{t.listening}</span>
        <span class="art-label label-bottom">{t.localPrivate}</span>
      </div>
    </section>

    <section id="features" class="section shell">
      <div class="section-heading"><p class="eyebrow">{t.featuresEyebrow}</p><h2>{t.featuresTitle}</h2><p>{t.featuresLead}</p></div>
      <div class="feature-grid">
        {features.map(([number, title, copy]) => <article class="feature"><span class="feature-number">{number}</span><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
    </section>

    <section id="pricing" class="section pricing-section">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">{t.plansEyebrow}</p><h2>{t.plansTitle}</h2><p>{t.plansLead}</p></div>
        <div class="price-grid">
          <article class="price-card"><p class="plan-label">PLAN-FREE</p><h3>{t.free}</h3><p class="price">$0 <small>{t.forever}</small></p><p class="plan-summary">{t.freeSummary}</p><a class="button button-secondary" href="#download">{t.getSpeech}</a><p class="limit">{t.unlimitedLocal}</p></article>
          <article class="price-card featured"><p class="plan-label">PLAN-PRO <span>{t.proRange}</span></p><h3>Pro</h3><p class="price">$— <small>{t.perMonth}</small></p><p class="plan-summary">{t.proSummary}</p><a class="button button-primary" href={loginUrl}>{t.choosePro}</a><p class="limit">{t.proLimit}</p></article>
        </div>
        <p class="pricing-note">{t.pricingNote}</p>
      </div>
    </section>

    <section id="download" class="cta shell">
      <p class="eyebrow">{t.ctaEyebrow}</p><h2>{t.ctaTitleA}<br /><em>{t.ctaTitleB}</em></h2>
      <p>{t.ctaLead}</p>
      <!-- Placeholder anchor: the dashboard has no public release downloads yet. -->
      <a class="button button-primary" href="#download">{t.download} <span>↗</span></a>
      <!-- Placeholder Keycloak URL: add-dashboard-ui creates speech-dashboard-web. -->
      <a class="text-link" href={loginUrl}>{t.loginSignup} <span>→</span></a>
    </section>
  </main>

  <footer class="footer shell"><a class="wordmark" href="/" aria-label={t.home}><span class="mark">S</span> speech</a><p>{t.footerLead}</p><p>{t.copyright}</p></footer>
</Layout>
