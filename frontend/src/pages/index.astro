---
import Layout from '../layouts/Layout.astro';

const features = [
  ['01', 'Private by design', 'Recording and transcription run locally with faster-whisper. Your voice stays on your computer.'],
  ['02', 'Hands-free when you want', 'Say “hey speech” or “oye speech” to start dictating, then say “stop” or go quiet to paste.'],
  ['03', 'Works where you work', 'Dictate into browsers, documents, chat apps, IDEs, and terminals.'],
  ['04', 'Speaks your language', 'Use automatic detection or choose from 100 supported languages.'],
  ['05', 'Fits your workflow', 'Choose your microphone, pin language favorites, and customize hotkeys and cleanup.'],
  ['06', 'Your vocabulary, your models', 'Bias transcription toward names and technical terms, and choose the model that fits your speed and accuracy needs.'],
];

const loginUrl = 'http://localhost:8080/realms/speech/protocol/openid-connect/auth?client_id=speech-dashboard-web';
---

<Layout>
  <header class="nav shell">
    <a class="wordmark" href="/" aria-label="Speech home"><span class="mark">S</span> speech</a>
    <nav aria-label="Main navigation">
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a class="nav-login" href={loginUrl}>Log in</a>
    </nav>
  </header>

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">Your voice, at the cursor<span class="dot">.</span></p>
        <h1>Say it once.<br /><em>Keep moving.</em></h1>
        <p class="lede">Local dictation that pastes wherever you type. Fast, private, and ready when you are.</p>
        <div class="actions">
          <a class="button button-primary" href="#download">Download Speech <span>↗</span></a>
          <a class="text-link" href={loginUrl}>Sign up free <span>→</span></a>
        </div>
        <p class="platforms">Windows · macOS · Linux &nbsp; / &nbsp; No account required for local dictation</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orb-glow"></div>
        <div class="orb"><div class="orb-core"></div></div>
        <div class="sound sound-one"></div><div class="sound sound-two"></div><div class="sound sound-three"></div>
        <span class="art-label label-top">LISTENING</span>
        <span class="art-label label-bottom">LOCAL · PRIVATE</span>
      </div>
    </section>

    <section id="features" class="section shell">
      <div class="section-heading"><p class="eyebrow">The good kind of quiet</p><h2>Speech stays out of the way.</h2><p>Everything you need to turn thoughts into text, without sending your voice anywhere.</p></div>
      <div class="feature-grid">
        {features.map(([number, title, copy]) => <article class="feature"><span class="feature-number">{number}</span><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
    </section>

    <section id="pricing" class="section pricing-section">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">Simple plans</p><h2>Start local. Go further.</h2><p>Keep local dictation free forever. Add cloud mode when you need it.</p></div>
        <div class="price-grid">
          <article class="price-card"><p class="plan-label">PLAN-FREE</p><h3>Free</h3><p class="price">$0 <small>forever</small></p><p class="plan-summary">Unlimited local transcription. Your audio and words stay on your computer.</p><a class="button button-secondary" href="#download">Get Speech</a><p class="limit">Unlimited words · local mode</p></article>
          <article class="price-card featured"><p class="plan-label">PLAN-PRO <span>For more range</span></p><h3>Pro</h3><p class="price">$— <small>per month</small></p><p class="plan-summary">Cloud mode for when you need extra flexibility, with a monthly word allowance.</p><a class="button button-primary" href={loginUrl}>Choose Pro</a><p class="limit">50,000 words / month · cloud mode</p></article>
        </div>
        <p class="pricing-note">Pro pricing and its 50,000-word monthly limit are editorial examples until the paid plan is seeded in the billing catalog.</p>
      </div>
    </section>

    <section id="download" class="cta shell">
      <p class="eyebrow">Make space for the thought</p><h2>Speak freely.<br /><em>Type less.</em></h2>
      <p>Speech runs quietly in the background and puts your words exactly where they belong.</p>
      <!-- Placeholder anchor: the dashboard has no public release downloads yet. -->
      <a class="button button-primary" href="#download">Download Speech <span>↗</span></a>
      <!-- Placeholder Keycloak URL: add-dashboard-ui creates speech-dashboard-web. -->
      <a class="text-link" href={loginUrl}>Log in or sign up <span>→</span></a>
    </section>
  </main>

  <footer class="footer shell"><a class="wordmark" href="/"><span class="mark">S</span> speech</a><p>Private dictation, everywhere.</p><p>© 2026 Speech</p></footer>
</Layout>
