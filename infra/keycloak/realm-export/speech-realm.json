{
  "realm": "speech",
  "enabled": true,
  "displayName": "Speech",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "es"],
  "defaultLocale": "en",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "plan-free",
        "description": "Placeholder plan role; billing will define limits."
      },
      {
        "name": "plan-pro",
        "description": "Placeholder plan role; billing will define limits."
      },
      {
        "name": "admin",
        "description": "Access to read-only administrative dashboard surfaces."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "plan-roles",
      "description": "Expose the user's plan role in the access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "plan-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "plan",
            "id.token.claim": "false",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "usermodel.client.role": "false",
            "usermodel.realm.role": "true"
          }
        },
        {
          "name": "subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-speech-dashboard-backend",
      "enabled": true,
      "serviceAccountClientId": "speech-dashboard-backend",
      "clientRoles": {"realm-management": ["manage-users"]}
    }
  ],
  "clients": [
    {
      "clientId": "speech-dashboard-backend",
      "name": "Speech Dashboard Backend",
      "description": "Confidential client for the server-side dashboard backend.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-speech-dashboard-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "bearerOnly": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic", "plan-roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "speech-desktop-device",
      "name": "Speech Desktop Device Flow",
      "description": "Public client for the speech app's OAuth2 Device Authorization Grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "bearerOnly": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic", "plan-roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "speech-dashboard-web",
      "name": "Speech Dashboard Web",
      "description": "Public browser client using Authorization Code with PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "bearerOnly": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4321/##https://dashboard.speech.app/"
      },
      "redirectUris": ["http://localhost:4321/auth/callback", "https://dashboard.speech.app/auth/callback"],
      "webOrigins": ["http://localhost:4321", "https://dashboard.speech.app"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic", "plan-roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ]
}
